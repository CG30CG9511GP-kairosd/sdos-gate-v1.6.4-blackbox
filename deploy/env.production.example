# Copy to deploy/.env.production and fill real values.
# NEVER commit .env.production.

# --- Identity / API ---
SDOS_API_KEY=replace-with-at-least-32-byte-random-api-key
SDOS_ED25519_PUBLIC_KEY_B64=replace-with-client-or-server-public-key-base64
SDOS_DEFAULT_TENANT_ID=default

# --- Ledger integrity (min 32 bytes each; MUST be distinct) ---
SDOS_LEDGER_HMAC_KEY=replace-with-ledger-hmac-key-min-32-bytes-long!!
SDOS_LEDGER_ANCHOR_HMAC_KEY=replace-with-DIFFERENT-anchor-hmac-key-32b!!

# --- Edge ports (host) ---
SDOS_HTTPS_PORT=443
SDOS_HTTP_PORT=80

# Optional lab-only reinit (must stay unset in normal production)
# LEDGER_REINIT=
# SDOS_LEDGER_REINIT_REASON=
# SDOS_LEDGER_REINIT_ACTOR=
